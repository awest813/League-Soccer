{
  "name": "gameplayfootball",
  "version-string": "0.4.0",
  "description": "League-Soccer / Gameplay Football dependencies for Windows (vcpkg)",
  "dependencies": [
    "boost-signals2",
    "boost-smart-ptr",
    "sdl2",
    {
      "name": "sdl2-image",
      "features": [ "libjpeg-turbo" ]
    },
    "sdl2-ttf",
    "sdl2-gfx",
    "opengl",
    "openal-soft",
    "sqlite3"
  ]
}
